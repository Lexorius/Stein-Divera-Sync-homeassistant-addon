# ============================================================================
# SteinAPI - Divera Sync Konfiguration
# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ============================================================================

# --- Divera24/7 ---
DIVERA_ACCESS_KEY=dein-divera-access-key
DIVERA_BASE_URL=https://app.divera247.com/api/v2

# --- Stein.app ---
STEIN_API_KEY=dein-stein-api-key
STEIN_BUSINESS_UNIT_ID=deine-business-unit-id
STEIN_BASE_URL=https://www.stein.app/api

# --- Sync-Verhalten ---
# sync_direction: both | divera_to_stein | stein_to_divera
SYNC_DIRECTION=both
SYNC_INTERVAL_MINUTES=5
AUTO_SYNC_ENABLED=true

# --- Sonstiges ---
TIMEZONE=Europe/Berlin
# log_level: debug | info | warning | error
LOG_LEVEL=info
MAX_LOG_ENTRIES=1000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Interner Port im Container. Der Host-Port wird in docker-compose.yml gemappt.
PORT=8099
